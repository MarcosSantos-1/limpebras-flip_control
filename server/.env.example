# Banco PostgreSQL (Neon). Em produção prefira a connection string "Pooled" do painel
# (host com -pooler) para o driver pg — reduz conexões diretas ao compute.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Intervalo mínimo (ms) entre UPDATE de last_seen_at por sessão — reduz writes no Neon (default 600000 = 10 min).
# AUTH_LAST_SEEN_THROTTLE_MS=600000

# TTL do cache em memória da API para KPIs/SACs/CNCs/IPT em ms (default 120000 = 2 min).
# CACHE_TTL_MS=120000

# Pool pg: máximo de conexões (omitir ou 0 = default do driver, tipicamente 10).
# DB_POOL_MAX=10

# Fechar conexões ociosas após N ms (default 30000).
# DB_IDLE_TIMEOUT_MS=30000

# Segredo usado para criptografar senhas e assinar sessões.
# Se mudar em produção, senhas antigas deixam de bater até o host redefinir cada uma no painel.
AUTH_SECRET=troque-por-um-segredo-forte

# Porta da API (padrão 3001)
PORT=3001
